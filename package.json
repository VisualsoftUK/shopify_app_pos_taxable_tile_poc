        "shopify-ext-dev": "if [ -d extensions ]; then find extensions -mindepth 1 -maxdepth 1 -type d -exec sh -c 'test -f \"$1/package.json\" && npm run dev --workspace=\"$1\" --if-present' _ {} \\;; fi",
        "shopify-ext-prod": "if [ -d extensions ]; then find extensions -mindepth 1 -maxdepth 1 -type d -exec sh -c 'test -f \"$1/package.json\" && npm run prod --workspace=\"$1\" --if-present' _ {} \\;; fi",
