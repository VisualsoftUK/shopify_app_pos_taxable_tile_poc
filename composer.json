{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^2.0",
        "kyon147/laravel-shopify": "^27.0.1",
        "laravel/framework": "^13.0",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.8",
        "laravel/tinker": "^3.0",
        "moneyphp/money": "^4.8",
        "predis/predis": "^3.5",
        "sentry/sentry-laravel": "^4.0",
        "spatie/laravel-csp": "^3.0",
        "spatie/laravel-data": "^4.15",
        "visualsoft/vs-laravel-monitoring": "^1.14.0",
        "visualsoft/vs-laravel-security-base": "^1.9.0",
        "visualsoft/vs-mantle": "^1.67.4",
        "visualsoft/vs-redis-cluster": "^1.0.0",
        "visualsoft/vs-shopify-admin": "^1.44.0",
        "visualsoft/vs-shopify-app-pricing": "^0.1.20",
        "visualsoft/vs-shopify-beacons": "^1.5.0",
        "visualsoft/vs-shopify-connector": "^1.62.0",
        "visualsoft/vs-shopify-partitions": "^1.3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "fruitcake/laravel-debugbar": "^4.2",
        "laravel/boost": "^2.0",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "spatie/laravel-ignition": "^2.0",
        "visualsoft/vs-ai-rules": "^1.0.0",
        "visualsoft/vs-shopify-browser-testing": "^1.26.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:install --silent"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185\" \"source ~/.nvm/nvm.sh && nvm exec npm run dev\" \"source ~/.nvm/nvm.sh && nvm exec npm run shopify-ext-dev\" \"source ~/.nvm/nvm.sh && nvm exec npm run shopify-dev\" --names=admin-npm,extension-npm,shopify-dev"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-laravel-monitoring"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-mantle"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-shopify-connector"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-laravel-security-base"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-shopify-admin"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-shopify-app-pricing"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-shopify-beacons"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-shopify-partitions"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-ai-rules"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-redis-cluster"
        },
        {
            "type": "vcs",
            "url": "https://github.com/VisualsoftUK/vs-shopify-browser-testing"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
