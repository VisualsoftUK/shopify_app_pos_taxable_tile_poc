APP_NAME="App_Template"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
LOG_CHANNEL=stderr
LOG_LEVEL=debug
APP_DOMAIN=localhost
APP_URL=http://${APP_DOMAIN}
APP_PORT=8080

DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=app_template
DB_USERNAME=app_template
DB_PASSWORD=secret

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

SHOPIFY_APP_NAME=${APP_NAME}
SHOPIFY_API_KEY=shopify_api_key_id
SHOPIFY_API_SECRET=supersecrettoken
SHOPIFY_MAIN_ID=shopify_app_extension_id
SHOPIFY_APP_TEMPLATE_ID=${SHOPIFY_MAIN_ID}
SHOPIFY_API_SCOPES="read_files,write_files,read_themes,read_locales,read_orders,write_orders,read_all_orders,read_products,write_products,read_customers,read_cart_transforms,write_cart_transforms,read_publications,write_publications"
SHOPIFY_API_VERSION=2026-04

# Expiring offline access tokens (required for public apps from April 2026)
SHOPIFY_EXPIRING_OFFLINE_TOKENS=true
SHOPIFY_AUTO_MIGRATE_LEGACY=true
SHOPIFY_OFFLINE_ACCESS_TOKEN_REFRESH_SKEW=60
# SHOPIFY_REFRESH_OFFLINE_TOKEN_BEFORE_API_CALL=false

# Proactive offline refresh-token renewal (shopify-app:refresh-expiring-offline-tokens)
SHOPIFY_OFFLINE_REFRESH_TOKEN_RENEWAL_DAYS=14
# Optional: blank uses the default queue
SHOPIFY_REFRESH_OFFLINE_TOKENS_JOB_QUEUE=

#Not required in running environment
SHOPIFY_APP_URL=${APP_URL}/app
SHOPIFY_APP_PREFERENCES_URL=${APP_URL}/settings
SHOPIFY_APP_HANDLE=app-template
# Share hosted pricing URLs to Inertia (`appPricing`) and `@appPricingConfig` (default true)
APP_PRICING_SHARE_FRONTEND=true
# Path-relative return after hosted plan selection. The package appends shop, host, and embedded.
APP_PRICING_POST_SUBSCRIPTION_REDIRECT=/app
# Leave empty so new installs must pick a hosted plan. Do not invent a local AppPlan.
# APP_PRICING_DEFAULT_PLAN_HANDLE=
# Lets shops that still only have a Mantle plan through until App Pricing has recorded a subscription.
APP_PRICING_MANTLE_PLAN_FALLBACK=true
# Mirror App Pricing into local mantle_* tables and force Mantle passive mode.
APP_PRICING_MANTLE_PARITY_ENABLED=true
# MUST be the app GID from the Shopify Dev Dashboard app URL. Differs per environment.
SHOPIFY_APP_GID=gid://shopify/App/1234567890
# Partner API client (Manage apps). Set in Swarm; leave blank locally.
SHOPIFY_PARTNER_ORGANISATION_ID=
SHOPIFY_PARTNER_ACCESS_TOKEN=
SHOPIFY_PARTNER_API_VERSION=2026-07
SHOPIFY_APP_REDIRECT_URL=${APP_URL}/authenticate
SHOPIFY_WEBHOOKS_URL=${APP_URL}/webhook
SHOPIFY_FLAG_CLIENT_ID=${SHOPIFY_API_KEY}

# Admin browser tests (pest-plugin-browser / vs-shopify-browser-testing)
# SHOPIFY_BROWSER_PROXY_PATH_PREFIX=/a/{handle}
# SHOPIFY_BROWSER_SCREENSHOT_WAIT_SECONDS=0.5

MANTLE_APP_ID=
MANTLE_API_KEY=
# Put Mantle into passive mode. App Pricing parity also forces this when enabled.
MANTLE_RUN_IN_PASSIVE_MODE=true
MANTLE_CUSTOMER_BEHAVIOUR_TRACKING_TOKEN=
MANTLE_HELP_DESK_WIDGET_ID=
MANTLE_JWT_SECRET=

GORGIAS_HELP_DESK_ENABLED=
GORGIAS_HELP_DESK_WIDGET_ID=
GORGIAS_HELP_DESK_BUNDLE_ID=

VS_API_SECRET=
CROSS_SELLING_VSAPI_APP_ID=

REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_HOST=redis
REDIS_CLIENT=phpredis
REDIS_CLUSTER=off
# REDIS_CLUSTER_HOSTS=redis-ha-shopify-testing01.internal.visualsoft.io:6379,redis-ha-shopify-testing02.internal.visualsoft.io:6379,redis-ha-shopify-testing03.internal.visualsoft.io:6379,redis-ha-shopify-testing04.internal.visualsoft.io:6379,redis-ha-shopify-testing05.internal.visualsoft.io:6379,redis-ha-shopify-testing06.internal.visualsoft.io:6379

# Reverb (WebSockets) — Docker defaults (matches other Visualsoft Shopify apps)
REVERB_APP_ID=1001
REVERB_APP_KEY=websockets
REVERB_APP_SECRET=secret

# Laravel → Reverb (internal docker network)
REVERB_HOST=reverb
REVERB_PORT=8088
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8088
REVERB_SERVER_PATH=/app/websockets

# Browser / extension clients (public via nginx + Cloudflare)
REVERB_PUBLIC_HOST=${APP_DOMAIN}
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_PUBLIC_HOST}"
VITE_REVERB_PORT="${REVERB_PUBLIC_PORT}"
VITE_REVERB_SCHEME="${REVERB_PUBLIC_SCHEME}"

# Laravel Herd built-in Reverb — comment out the Docker block above and use these instead:
# REVERB_APP_ID=1001
# REVERB_APP_KEY=laravel-herd
# REVERB_APP_SECRET=secret
# REVERB_HOST="reverb.herd.test"
# REVERB_PORT=443
# REVERB_SCHEME=https
# REVERB_PUBLIC_HOST=reverb.herd.test
# REVERB_PUBLIC_PORT=443
# REVERB_PUBLIC_SCHEME=https
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_PUBLIC_HOST}"
# VITE_REVERB_PORT="${REVERB_PUBLIC_PORT}"
# VITE_REVERB_SCHEME="${REVERB_PUBLIC_SCHEME}"
# (Omit REVERB_SERVER_* when Herd runs the server.)
